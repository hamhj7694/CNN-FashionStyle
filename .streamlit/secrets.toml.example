# 실제 secrets.toml 파일은 생성 후 Git에 커밋하지 마세요.
# 업로드 스크립트는 이 파일이 아니라 PowerShell 환경변수를 사용합니다.

R2_ACCOUNT_ID = "your-cloudflare-account-id"
R2_ACCESS_KEY_ID = "your-r2-access-key-id"
R2_SECRET_ACCESS_KEY = "your-r2-secret-access-key"
R2_BUCKET_NAME = "moodfit-assets"
R2_PUBLIC_BASE_URL = "https://your-assets-domain.example.com"
